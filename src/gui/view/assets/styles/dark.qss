QMainWindow {
    background-color: #0D0F14;
}

QSplitter::handle {
    background-color: #232838;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #38BDF8;
}

QTableView {
    background-color: #13161F;
    border: 1px solid #232838;
    qproperty-showGrid: false;
    outline: none;
}

QTableView::item:hover {
    background-color: #1A1E2B;
    color: #E2E8F0;
}

QTableView::item:selected {
    background-color: #1E283D;
    color: #FFFFFF;
}

QHeaderView {
    background-color: #0D0F14;
    border: none;
}

QHeaderView::section {
    background-color: #0D0F14;
    color: #8C8C9A;
    padding: 2px 4px;
    border: none;
    border-bottom: 2px solid #232838;
    font-weight: 600;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid #232838;
    background-color: #13161F;
}

QTabBar::tab {
    background-color: #0D0F14;
    color: #8A91A8;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #E2E8F0;
    background-color: #1A1E2B;
}

QTabBar::tab:selected {
    color: #E2E8F0;
    background-color: #13161F;
    border-bottom: 2px solid #38BDF8;
}

QMenuBar {
    background-color: #0D0F14;
    color: #8A91A8;
    border: none;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
    margin: 2px;
}

QMenuBar::item:selected {
    background-color: #1A1E2B;
    color: #E2E8F0;
}

QMenu {
    background-color: #13161F;
    color: #E2E8F0;
    border: 1px solid #232838;
    border-radius: 6px;
    padding: 4px 0px;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
    background-color: transparent;
    border: none;
    margin: 1px 4px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1E283D;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #232838;
    margin: 4px 6px;
}

QMenu::shortcut {
    color: #555D73;
    padding-left: 16px;
}

QToolTip {
    background-color: #1A1E2B;
    color: #E2E8F0;
    border: 1px solid #232838;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #0D0F14;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #232838;
    min-height: 28px;
    border: 3px solid #0D0F14;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #3B4259;
}

QScrollBar::handle:vertical:pressed {
    background: #4E5775;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QWidget#DebuggerPanel {
    background-color: #0D0F14;
    border-bottom: 1px solid #232838;
}

QWidget#DebuggerPanel QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 6px;
}

QWidget#DebuggerPanel QPushButton:pressed {
    padding-top: 5px;
    padding-left: 7px;
}

QWidget#DebuggerPanel QPushButton:disabled {
    opacity: 0.25;
}

QPushButton#runBtn:hover {
    background-color: rgba(82, 229, 98, 0.12);
    border: 1px solid #52E562;
}

QPushButton#runBtn:pressed {
    background-color: rgba(82, 229, 98, 0.28);
    border: 1px solid #3ca848;
}

QPushButton#pauseBtn:hover {
    background-color: rgba(56, 189, 248, 0.12);
    border: 1px solid #38BDF8;
}

QPushButton#pauseBtn:pressed {
    background-color: rgba(56, 189, 248, 0.28);
    border: 1px solid #228cb8;
}

QPushButton#stepIntoBtn:hover {
    background-color: rgba(220, 225, 92, 0.12);
    border: 1px solid #DCE15C;
}

QPushButton#stepIntoBtn:pressed {
    background-color: rgba(220, 225, 92, 0.28);
    border: 1px solid #a6a943;
}

QWidget#InlineErrorCard QLabel#ErrorIconLabel {
    font-size: 14px;
}

QWidget#InlineErrorCard QLabel#ErrorMessageLabel {
    color: #E3E6ED;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
}
