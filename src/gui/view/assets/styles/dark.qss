QTableView {
    background-color: #1e1e1e;
    border: 1px solid #2d2d2d;
}

QToolTip {
    background-color: #252936;
    color: #e3e6ed;

    border: 1px solid #3d4457;
    border-radius: 4px;

    padding: 3px 6px;

    font-family: "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}


QScrollBar:vertical {
    background: #1e1e1e;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3e3e42;
    min-height: 30px;

    border: 6px solid #1e1e1e;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #505055;
    border: 5px solid #1e1e1e;
    border-radius: 7px;
}

QScrollBar::handle:vertical:pressed {
    background: #68686d;
    border: 5px solid #1e1e1e;
    border-radius: 7px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


QWidget#DebuggerPanel {
    background-color: #14171D;
    border-bottom: 2px solid #2D313E;
}

QWidget#DebuggerPanel QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
    padding: 4px;
}

QWidget#DebuggerPanel QPushButton:pressed {
    padding-top: 5px;
    padding-left: 5px;

}

QWidget#DebuggerPanel QPushButton:disabled {
    opacity: 0.25;
}

QPushButton#runBtn:hover {
    background-color: rgba(82, 229, 98, 0.12);
    border: 1px solid #52E562;
}

QPushButton#runBtn:pressed {
    background-color: rgba(82, 229, 98, 0.35);
    border: 1px solid #3ca848;
}

QPushButton#pauseBtn:hover {
    background-color: rgba(56, 189, 248, 0.12);
    border: 1px solid #38BDF8;
}
QPushButton#pauseBtn:pressed {
    background-color: rgba(56, 189, 248, 0.35);
    border: 1px solid #228cb8;
}

QPushButton#stepIntoBtn:hover {
    background-color: rgba(220, 225, 92, 0.12);
    border: 1px solid #DCE15C;
}

QPushButton#stepIntoBtn:pressed {
    background-color: rgba(220, 225, 92, 0.35);
    border: 1px solid #a6a943;
}
